POSTGRES_DB=shoppyshop
POSTGRES_USER=shoppyshop
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Add secrets with `dotnet user-secrets` or export them in your shell. Never commit real values.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=shoppyshop;Username=shoppyshop;Password=local-development-only
Jwt__Issuer=shoppy-shop-api
Jwt__Audience=shoppy-shop
Jwt__SigningKey=replace-with-at-least-32-random-characters-long
BootstrapAdmin__Email=admin@shoppyshop.test
BootstrapAdmin__Password=replace-with-a-strong-local-password
Anthropic__ApiKey=replace-with-your-anthropic-api-key
Anthropic__Model=claude-haiku-4-5
Cors__AllowedOrigins__0=https://shoppy-shop-zeta.vercel.app
