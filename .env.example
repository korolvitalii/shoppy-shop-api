POSTGRES_DB=shoppyshop
POSTGRES_USER=shoppyshop
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# Add these values to .NET user-secrets when the API project exists.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=shoppyshop;Username=shoppyshop;Password=replace-with-a-local-password
Jwt__Issuer=shoppy-shop-api
Jwt__Audience=shoppy-shop
Jwt__SigningKey=replace-with-at-least-32-random-characters
BootstrapAdmin__Email=admin@shoppyshop.test
BootstrapAdmin__Password=replace-with-a-strong-local-password
